



import sys, os, time, json



def 记忆卡组件(记忆卡实例):



    return {

        '名称': lambda: '记忆卡',

        '处理': lambda 数据: 记忆卡实例.store(数据) if isinstance(数据, str) and not 数据.startswith('search:') else (

            记忆卡实例.search(数据[7:]) if 数据.startswith('search:') else {'ok': False}

        ),

        '训练': lambda 数据, 来源=None: None,

        '保存': lambda 路径=None: None,

        '加载': lambda 路径=None: None,

    }



def 心跳组件():



    try:

        sys.path.insert(0, os.path.dirname(__file__))

        from 派心跳 import 派心跳组件

        return 派心跳组件(interval=60)

    except Exception as e:

        print(f'[slot] 派心跳加载失败: {e}')

        return {

        '名称': lambda: '心跳检测',

        '处理': lambda 数据: _心跳() if isinstance(数据, str) else None,

        '训练': lambda 数据, 来源=None: None,

        '保存': lambda 路径=None: None,

        '加载': lambda 路径=None: None,

    }



def 向量组件():



    try:

        sys.path.insert(0, os.path.dirname(__file__))

        from slot_向量 import 向量

        vm = 向量()

        return {

            '名称': lambda: '向量记忆',

            '处理': lambda 数据: vm.搜(数据[3:]) if isinstance(数据, str) and 数据.startswith('q:') else (

                vm.记(数据) if isinstance(数据, str) else {'ok': False}

            ),

            '训练': lambda 数据, 来源=None: vm.记(str(数据)) if 数据 else None,

            '保存': lambda 路径=None: None,

            '加载': lambda 路径=None: None,

            '搜': lambda 查询, k=5: vm.搜(查询, k),

            '记': lambda 文本, 标题='', 标签=None: vm.记(文本, 标题, 标签),

            '条数': lambda: vm.条数(),

            '状态': lambda: vm.状态(),

        }

    except Exception as e:

        print(f'[slot] 向量加载失败: {e}')

        return {

            '名称': lambda: '向量记忆',

            '处理': lambda 数据: None,

            '训练': lambda 数据, 来源=None: None,

            '保存': lambda 路径=None: None,

            '加载': lambda 路径=None: None,

        }



def 海马体组件():



    try:

        sys.path.insert(0, os.path.dirname(__file__))

        from slot_海马体 import 海马体

        mb = 海马体()



        from slot_组件 import 向量组件

        mb.插入(向量组件())



        return {

            '名称': lambda: '海马体',

            '处理': lambda 数据: mb.投喂(数据),

            '训练': lambda 数据, 来源=None: mb.训练(数据, 来源) if 数据 else mb.睡眠巩固(),

            '保存': lambda 路径=None: None,

            '加载': lambda 路径=None: None,

            '搜': lambda 查询, k=5: mb.搜(查询, k),

            '投喂': lambda 数据: mb.投喂(数据),

            '插槽': lambda: mb.插槽列表(),

            '状态': lambda: mb.状态(),

        }

    except Exception as e:

        print(f'[slot] 海马体加载失败: {e}')

        return {

            '名称': lambda: '海马体',

            '处理': lambda 数据: None,

            '训练': lambda 数据, 来源=None: None,

            '保存': lambda 路径=None: None,

            '加载': lambda 路径=None: None,

        }



def 蒸馏组件():



    try:

        sys.path.insert(0, os.path.dirname(__file__))

        from slot_向量 import 向量

        from slot_蒸馏 import 知识蒸馏器

        vm = 向量()

        kd = 知识蒸馏器(vm)



        kd.蒸馏()

        return {

            '名称': lambda: '知识蒸馏',

            '处理': lambda 数据: None,

            '训练': lambda 数据, 来源=None: kd.蒸馏() if 数据 is None else None,

            '保存': lambda 路径=None: None,

            '加载': lambda 路径=None: None,

            '蒸馏': lambda: kd.蒸馏(),

            '搜': lambda 查询, k=3: kd.查询蒸馏(查询, k),

            '状态': lambda: kd.状态(),

        }

    except Exception as e:

        print(f'[slot] 蒸馏加载失败: {e}')

        return {

            '名称': lambda: '知识蒸馏',

            '处理': lambda 数据: None,

            '训练': lambda 数据, 来源=None: None,

            '保存': lambda 路径=None: None,

            '加载': lambda 路径=None: None,

        }



