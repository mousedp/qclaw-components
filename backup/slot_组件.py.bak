def 图谱组件():



    try:

        sys.path.insert(0, os.path.dirname(__file__))

        from slot_向量 import 向量

        from slot_图谱 import 知识图谱

        vm = 向量()

        kg = 知识图谱(vm)

        kg.构建()

        return {

            '名称': lambda: '知识图谱',

            '处理': lambda 数据: None,

            '训练': lambda 数据, 来源=None: kg.构建() if 数据 is None else None,

            '保存': lambda 路径=None: None,

            '加载': lambda 路径=None: None,

            '构建': lambda: kg.构建(),

            '搜': lambda 查询, k=5: kg.搜(查询, k),

            '查询': lambda 实体, 深度=2, 最多=5: kg.查询(实体, 深度, 最多),

            '状态': lambda: kg.状态(),

        }

    except Exception as e:

        print(f'[slot] 图谱加载失败: {e}')

        return {

            '名称': lambda: '知识图谱',

            '处理': lambda 数据: None,

            '训练': lambda 数据, 来源=None: None,

            '保存': lambda 路径=None: None,

            '加载': lambda 路径=None: None,

        }





def 上下文组件():

    """包装长上下文为插槽格式"""

    try:

        sys.path.insert(0, os.path.dirname(__file__))

        from slot_上下文 import 长上下文

        ctx = 长上下文(窗口大小=50)

        return {

            '名称': lambda: '长上下文',

            '处理': lambda 数据: ctx.喂(str(数据)) if 数据 else None,

            '训练': lambda 数据, 来源=None: None,

            '保存': lambda 路径=None: None,

            '加载': lambda 路径=None: None,

            '喂': lambda 内容, 类型='消息', 重要度=0: ctx.喂(内容, 类型, 重要度),

            '标记': lambda 索引=None, id=None: ctx.标记(索引, id),

            '浓缩': lambda 压缩比=0.5: ctx.浓缩(压缩比),

            '获取': lambda 格式='文本': ctx.获取(格式),

            '统计': lambda: ctx.统计(),

            '状态': lambda: ctx.统计(),

        }

    except Exception as e:

        print(f'[slot] 上下文加载失败: {e}')

        return {

            '名称': lambda: '长上下文',

            '处理': lambda 数据: None,

            '训练': lambda 数据, 来源=None: None,

            '保存': lambda 路径=None: None,

            '加载': lambda 路径=None: None,

        }



